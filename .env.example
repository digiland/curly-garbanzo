# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- required ----------------------------------------------------------
# Cloudflare named-tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel)
TUNNEL_TOKEN=

# Shared caimex API key, seeded into every user's auth.json at container start
CAIMEX_API_KEY=

# Public hostname you mapped in the Cloudflare dashboard
PUBLIC_HOSTNAME=notebooks.example.com

# ---- optional: self-service signup approval ----------------------------
# Without these, every signup waits for an admin at /hub/authorize.
# With them, a signup whose email matches SELF_APPROVAL_DOMAINS is emailed an
# activation link and needs no human.
#
# Delivery goes over the Resend HTTPS API, not SMTP: DigitalOcean blocks
# outbound 25/465/587, and NativeAuthenticator's built-in mailer is hardcoded to
# SMTP_SSL (port 465), so the stock path cannot work on this host.
RESEND_API_KEY=
APPROVAL_FROM_EMAIL=notebooks@example.com
SELF_APPROVAL_DOMAINS=example.com,example.org

# ---- optional: Caimex account and one-click Open Caimex -----------------
# With all five set, a user's first sign-in creates their Caimex account in this
# organisation with the same email and password, and "Open Caimex" in the nav
# takes them there already signed in. See docs/CAIMEX.md.
#
# The hub signs in to Caimex as the service account to invite each user and to
# set each member's free allowance (CAIMEX_FREE_ALLOWANCE_USD in
# charts/jupyterhub-values.yaml). Use a dedicated account on a real mailbox you
# control, with the Admin role in the organisation (not the owner, and not a
# person's account), and two-factor OFF. Both addresses must be https.
CAIMEX_API_URL=https://api.caimex.ai
CAIMEX_WEB_URL=https://caimex.ai
CAIMEX_ORG_ID=
CAIMEX_SERVICE_EMAIL=
CAIMEX_SERVICE_PASSWORD=

# ---- optional: password reset by email -----------------------------------
# "Forgot password?" on the sign-in page emails a one-time link (30 minutes).
# Needs a sender: RESEND_API_KEY above, or a mailbox over SMTP below; and a
# from-address. Links point to https://PUBLIC_HOSTNAME. Off without them.
# See docs/PASSWORD-RESET.md.
MAIL_FROM=
SMTP_HOST=
# 587 with starttls (most providers), or 465 with ssl.
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- optional: online payment for credit ------------------------------
# Econet's Eco Payments API (card and EcoCash, through Sasai). With the client id
# and secret, the credit form on Account offers "Pay now" and the credit is
# added as soon as the payment goes through. Leave them empty to keep only
# requests that an administrator approves. See docs/PAYMENTS.md.
# The payer is sent back to https://PUBLIC_HOSTNAME (above), and the provider
# calls https://PUBLIC_HOSTNAME/hub/api/zai/payments/webhook.
ECO_PAYMENTS_URL=https://api-prod.developer.econet.co.zw/eco-payments/v1
ECO_PAYMENTS_CLIENT_ID=
ECO_PAYMENTS_CLIENT_SECRET=

# ---- optional: signup captcha ------------------------------------------
# The signup form is reachable from the open internet. Without a captcha it will
# eventually collect bot registrations, each of which an admin has to triage.
# https://www.google.com/recaptcha/admin -> reCAPTCHA v2 "I'm not a robot"
RECAPTCHA_KEY=
RECAPTCHA_SECRET=

# ---- optional: object storage (S3-compatible, e.g. DigitalOcean Spaces) --
# Unset -> the `spaces` command reports it is unconfigured and notebooks start
# normally. Set -> every user gets a private prefix, an rclone remote and
# preconfigured boto3.
# NOTE: Spaces is not offered in every region (atl1 has none); a bucket in the
# nearest Spaces region works fine, it just pays cross-region egress.
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- optional: user storage sizing -------------------------------------
# Size of the quota-enforced XFS image created by scripts/07-user-storage.sh.
# Must fit on / with room to spare; see the script's pre-flight check.
USER_STORAGE_SIZE=150G
