# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- required ----------------------------------------------------------
# Cloudflare named-tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel)
TUNNEL_TOKEN=

# Shared caimex API key, seeded into every user's auth.json at container start
CAIMEX_API_KEY=

# Public hostname you mapped in the Cloudflare dashboard
PUBLIC_HOSTNAME=notebooks.example.com

# ---- optional: self-service signup approval ----------------------------
# Without these, every signup waits for an admin at /hub/authorize.
# With them, a signup whose email matches SELF_APPROVAL_DOMAINS is emailed an
# activation link and needs no human.
#
# Delivery goes over the Resend HTTPS API, not SMTP: DigitalOcean blocks
# outbound 25/465/587, and NativeAuthenticator's built-in mailer is hardcoded to
# SMTP_SSL (port 465), so the stock path cannot work on this host.
RESEND_API_KEY=
APPROVAL_FROM_EMAIL=notebooks@example.com
SELF_APPROVAL_DOMAINS=example.com,example.org

# ---- optional: signup captcha ------------------------------------------
# The signup form is reachable from the open internet. Without a captcha it will
# eventually collect bot registrations, each of which an admin has to triage.
# https://www.google.com/recaptcha/admin -> reCAPTCHA v2 "I'm not a robot"
RECAPTCHA_KEY=
RECAPTCHA_SECRET=

# ---- optional: object storage (S3-compatible, e.g. DigitalOcean Spaces) --
# Unset -> the `spaces` command reports it is unconfigured and notebooks start
# normally. Set -> every user gets a private prefix, an rclone remote and
# preconfigured boto3.
# NOTE: Spaces is not offered in every region (atl1 has none); a bucket in the
# nearest Spaces region works fine, it just pays cross-region egress.
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- optional: user storage sizing -------------------------------------
# Size of the quota-enforced XFS image created by scripts/07-user-storage.sh.
# Must fit on / with room to spare; see the script's pre-flight check.
USER_STORAGE_SIZE=150G
